{
  "name": "integration-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "deps:up": "docker compose up -d --wait postgres redis",
    "obs:up": "docker compose up -d --wait prometheus grafana jaeger",
    "app:up": "docker compose --profile app up -d --build --wait mock hub worker-1 worker-2",
    "stack:up": "docker compose --profile app --profile simulator build && docker compose --profile app up -d --wait postgres redis prometheus grafana jaeger mock hub worker-1 worker-2 && docker compose --profile app --profile simulator run --rm simulator",
    "stack:down": "docker compose --profile app --profile simulator down -v",
    "deps:down": "docker compose down -v",
    "migrate": "pnpm --filter @integration-hub/hub migrate",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "demo:naive-race": "pnpm --filter @integration-hub/hub demo:naive-race",
    "bigrun": "pnpm --filter @integration-hub/bigrun bigrun",
    "bigrun:publish": "pnpm --filter @integration-hub/bigrun publish-results",
    "loadtest": "pnpm --filter @integration-hub/bigrun loadtest",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs --exclude \"(^|/)(node_modules|dist)/\"",
    "cacherun": "pnpm --filter @integration-hub/bigrun cacherun",
    "contract:check": "pnpm --filter @integration-hub/contract-check contract:check"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.9.0"
  }
}
