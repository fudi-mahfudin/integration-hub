{
  "name": "integration-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "deps:up": "docker compose up -d --wait postgres redis",
    "obs:up": "docker compose up -d --wait prometheus grafana jaeger",
    "app:up": "docker compose --profile app up -d --build --wait hub worker-1 worker-2",
    "deps:down": "docker compose down -v",
    "migrate": "pnpm --filter @integration-hub/hub migrate",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "demo:naive-race": "pnpm --filter @integration-hub/hub demo:naive-race",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs --exclude \"(^|/)(node_modules|dist)/\""
  },
  "devDependencies": {
    "dependency-cruiser": "^18.9.0"
  }
}
