        "graphMode": "area"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Divergences in the latest completed reconciliation run",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
