{
  "$comment": "Fixed before any result exists. Every change needs a reason in its commit message. Sources: issues #13, #19, #20. History: https://github.com/fudi-mahfudin/integration-hub/commits/main/bigrun.commitments.json",
  "bigRun": {
    "mode": "replay+mock",
    "driver": "simulator",
    "events": {
      "visits": 2000,
      "eventsPerVisit": 4,
      "duplicates": 2000,
      "total": 10000,
      "allValid": true
    },
    "duplicateTimingPercent": {
      "concurrent": 50,
      "delayed": 30,
      "late": 20
    },
    "duplicateDelayedWindowSeconds": { "min": 0.5, "max": 10 },
    "eventMixPercent": {
      "outOfOrder": 10,
      "substitution": 10,
      "fallbackPersonLookup": 10
    },
    "seed": 240001,
    "faults": {
      "scope": "every FHIR and KFA call; token endpoint excluded; transient kinds only",
      "read": {
        "match": "GET/search, KFA",
        "totalPercent": 30,
        "weights": {
          "http_500": 6,
          "http_503": 6,
          "http_429": 6,
          "timeout": 6,
          "connection_reset": 6
        },
        "http_503RetryAfter": "half with Retry-After",
        "http_429RetryAfter": "absent / seconds / HTTP date, split evenly"
      },
      "write": {
        "match": "POST/PUT",
        "totalPercent": 30,
        "weights": {
          "timeout_after_apply": 7,
          "http_500_after_apply": 7,
          "http_500": 4,
          "http_503": 4,
          "http_429": 4,
          "timeout": 2,
          "connection_reset": 2
        }
      }
    },
    "mockProfile": {
      "fhirRps": 100,
      "kfaRps": 50,
      "callTimeoutMs": 2000
    },
    "retryCap": 15,
    "rate": {
      "eventsPerSecond": 50,
      "loop": "open"
    },
    "topology": {
      "hubServices": 1,
      "workers": 2,
      "composeLimits": {
        "hub": { "cpus": 1, "memory": "512m" },
        "worker": { "cpus": 1, "memory": "512m" },
        "postgres": { "cpus": 2, "memory": "1g" },
        "redis": { "cpus": 0.5, "memory": "256m" },
        "mock": { "cpus": 1, "memory": "512m" },
        "prometheus": { "cpus": 0.5, "memory": "512m" }
      }
    },
    "deadlines": {
      "noProgressFailFastMinutes": 10,
      "hardDeadlineMinutes": 60
    },
    "invariants": {
      "lostEvents": 0,
      "duplicateSubmissions": 0,
      "orderPreservedPerCase": true,
      "deadLetteredCases": 0,
      "abandonedCases": 0
    },
    "informationOnly": [
      "throughput",
      "ingest latency p50/p95/p99",
      "end-to-end case latency p50/p95/p99/max",
      "outbox lag max/p95",
      "attempts per step",
      "realized fault rate per group",
      "breaker opens, limiter wait p95, upstream calls by status class",
      "post-drain on-demand reconciliation counts"
    ]
  },
  "loadTest": {
    "tool": "k6",
    "executor": "constant-arrival-rate",
    "eventsPerSecond": 200,
    "durationSeconds": 300,
    "warmUpSeconds": 30,
    "faults": false,
    "duplicatePercent": 20,
    "thresholds": {
      "p95Ms": 200,
      "p99Ms": 500,
      "non2xxPercent": 0.1
    }
  },
  "cacheRun": {
    "harness": "bigRun event mix, rate and topology",
    "faults": false,
    "mockLatencyMs": {
      "read": 150,
      "write": 300
    },
    "mockLatencyNote": "assumed constants, not sandbox measurements",
    "arms": ["off", "practitioner_only", "both"],
    "runsPerArm": 3,
    "order": "alternating",
    "barToStay": {
      "upstreamReadsPerCompletedCaseReductionPercentMin": 20,
      "e2eP95ImprovementPercentMin": 10,
      "e2eP95ImprovementMustExceedArmSpread": true,
      "officialBigRunPassesWithCacheOn": true
    }
  },
  "worldDataset": {
    "patients": 1000,
    "patientDraw": "uniform",
    "practitioners": 30
  }
}
