# Defaults already match compose.yaml; set these only to override.
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
PORT=3000
# Source systems: JSON array of {id, organizationId, apiKey}. Unset = one dev source "simulator" / "dev-source-key".
# HUB_SOURCES=[{"id":"simulator","organizationId":"99000001","apiKey":"dev-source-key"}]
# postgres (default) or naive-redis (deliberately broken, demo only; see README)
IDEMPOTENCY_STORE=postgres
# Idempotency keys are kept at least this long (never below 24), purged every interval
IDEMPOTENCY_RETENTION_HOURS=24
IDEMPOTENCY_PURGE_INTERVAL_MS=3600000
# Host ports compose publishes Postgres and Redis on
POSTGRES_PORT=5432
REDIS_PORT=6379
# Operator mapping seed (source, locationCode -> SATUSEHAT Location), upserted at hub boot
# MAPPING_SEED_PATH=apps/hub/seed/mappings.json
# SATUSEHAT platform (defaults: the standalone mock on :4010 and its public test credentials)
SATUSEHAT_AUTH_URL=http://localhost:4010/oauth2/v1
SATUSEHAT_FHIR_URL=http://localhost:4010/fhir-r4/v1
SATUSEHAT_KFA_URL=http://localhost:4010/kfa-v2
SATUSEHAT_CLIENT_ID=mock-client-id
SATUSEHAT_CLIENT_SECRET=mock-client-secret
# Worker: lease per claim (90s, #13), idle poll, parallel steps per process, placeholder retry delay
WORKER_LEASE_MS=90000
WORKER_POLL_INTERVAL_MS=500
WORKER_CONCURRENCY=4
WORKER_RETRY_DELAY_MS=1000
