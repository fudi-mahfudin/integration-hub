# Defaults already match compose.yaml; set these only to override.
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
PORT=3000
# The port a worker serves /metrics on; a second worker on the same host needs another (e.g. 3003)
WORKER_PORT=3002
# Source systems, one static API key each (JSON). Placeholder values only;
# unset, the hub runs with one public development key (dev-source-key).
# HUB_SOURCES=[{"id":"hospital-a","organizationId":"<satusehat-org-id>","apiKey":"<secret>"}]
# The operator's admin API key (replay, abandon, mapping administration). Placeholder only;
# unset, the hub runs with the public development key dev-admin-key.
# HUB_ADMIN_API_KEY=<secret>
# How long a waiting case waits before the case view flags it stalled (ms; default 24h)
# STALLED_AFTER_MS=86400000
# postgres (default) or naive-redis (deliberately broken, ADR 0003 demo only)
IDEMPOTENCY_STORE=postgres
# Idempotency keys are kept at least this long; at least 24
IDEMPOTENCY_RETENTION_HOURS=24
# How often expired keys are purged; 0 turns the purge timer off
IDEMPOTENCY_PURGE_INTERVAL_MS=3600000
# The SATUSEHAT the worker delivers to; defaults are a mock SATUSEHAT on localhost:3001.
# SATUSEHAT_AUTH_URL=http://localhost:3001/oauth2/v1/
# SATUSEHAT_FHIR_URL=http://localhost:3001/fhir-r4/v1/
# SATUSEHAT_KFA_URL=http://localhost:3001/kfa-v2/
# How long a KFA v2 lookup may take (ms) before the attempt gives up; a timeout is transient
# SATUSEHAT_KFA_TIMEOUT_MS=10000
# SATUSEHAT_CLIENT_ID=<client-id>
# SATUSEHAT_CLIENT_SECRET=<secret>
# mock (default) or live-sandbox: picks the call timeout and the hub's own rate limits (FHIR/KFA 100/50 rps, or 5/2)
# SATUSEHAT_PROFILE=mock
# How many worker processes run: while Redis is down, each keeps to this share of the rate limit on its own
WORKER_PROCESSES=2
# How long a platform API's circuit breaker stays open before it lets one probe call through (ms)
# SATUSEHAT_BREAKER_OPEN_MS=30000
# How long a worker's claim on a step lasts (ms) and how often an idle worker looks for work (ms)
WORKER_LEASE_MS=90000
WORKER_POLL_INTERVAL_MS=1000
# Shutdown: how long a stopping worker lets its attempt in progress run (ms; default 70s), and how long
# the hub service keeps serving after its readiness turns draining, for a load balancer (ms; default 0)
# WORKER_DRAIN_DEADLINE_MS=70000
# SHUTDOWN_DELAY_MS=0
# Reconciliation: a scheduled run once the last started this long ago (ms; 0 turns the schedule off),
# over the cases changed within the lookback (ms; default 7 days)
# RECONCILIATION_INTERVAL_MS=900000
# RECONCILIATION_LOOKBACK_MS=604800000
# Traces: the share sampled where a trace starts (0-1; parent-based, the big run uses 0.05), and Jaeger's OTLP/HTTP endpoint
# TRACE_SAMPLE_RATIO=1
# TRACE_EXPORT_URL=http://localhost:4318/v1/traces
# The IHS-number cache on (ihs_practitioner, the default, or none), and the
# secret its Redis keys are made with from the NIK. Placeholder only; unset, the public dev-ihs-cache-pepper.
# IHS_CACHES=ihs_practitioner
# IHS_CACHE_PEPPER=<secret>
# Host ports compose publishes Postgres and Redis on
POSTGRES_PORT=5432
REDIS_PORT=6379
