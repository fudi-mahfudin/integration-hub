# Defaults already match compose.yaml; set these only to override.
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
PORT=3000
# Source systems, one static API key each (JSON). Placeholder values only;
# unset, the hub runs with one public development key (dev-source-key).
# HUB_SOURCES=[{"id":"hospital-a","organizationId":"<satusehat-org-id>","apiKey":"<secret>"}]
# postgres (default) or naive-redis (deliberately broken, ADR 0003 demo only)
IDEMPOTENCY_STORE=postgres
# Idempotency keys are kept at least this long; at least 24
IDEMPOTENCY_RETENTION_HOURS=24
# How often expired keys are purged; 0 turns the purge timer off
IDEMPOTENCY_PURGE_INTERVAL_MS=3600000
# Host ports compose publishes Postgres and Redis on
POSTGRES_PORT=5432
REDIS_PORT=6379
