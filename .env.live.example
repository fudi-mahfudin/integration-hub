# The SATUSEHAT sandbox, for the contract check (`pnpm contract:check`) and the live check.
# Copy to .env.live (git-ignored) or, better, let the wizard write it:
#   bash scripts/wizards/sandbox-credentials.sh
# Values come from the portal: Sandbox (top left) > Kode Akses API. Placeholders only here.
SATUSEHAT_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1/
SATUSEHAT_FHIR_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1/
SATUSEHAT_KFA_URL=https://api-satusehat-stg.dto.kemkes.go.id/kfa-v2/
SATUSEHAT_ORGANIZATION_ID=<sandbox-organization-id>
SATUSEHAT_CLIENT_ID=<sandbox-client-id>
SATUSEHAT_CLIENT_SECRET=<sandbox-client-secret>
